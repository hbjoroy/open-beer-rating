# Encryption (generate a 32-byte key: openssl rand -base64 32)
ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# JWT
JWT_SECRET=CHANGE_ME_generate_a_strong_secret

# Server
API_HOST=0.0.0.0
API_PORT=3000
RUST_LOG=info
